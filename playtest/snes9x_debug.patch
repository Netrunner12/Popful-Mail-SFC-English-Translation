diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
index b7aaace..139295d 100644
--- a/libretro/libretro.cpp
+++ b/libretro/libretro.cpp
@@ -2663,3 +2663,25 @@ void S9xAutoSaveSRAM()
 {
     return;
 }
+uint32 g_watch_lo=0xFFFFFFFF, g_watch_hi=0;
+static FILE* g_watch_f=NULL;
+void g_watch_log(uint32 wa,uint32 pc,uint8 b){ if(!g_watch_f) { char nm[96]; snprintf(nm,sizeof nm,"/tmp/snestest/watch_%d.log",(int)getpid()); g_watch_f=fopen(nm,"w"); } fprintf(g_watch_f,"%05X %06X %02X\n",wa,pc,b); }
+extern "C" RETRO_API void dbg_set_watch(unsigned lo,unsigned hi){ g_watch_lo=lo; g_watch_hi=hi; if(g_watch_f){fflush(g_watch_f);} }
+extern "C" RETRO_API void dbg_flush(void){ if(g_watch_f) fflush(g_watch_f); }
+uint32 g_rwatch_lo=0xFFFFFFFF, g_rwatch_hi=0;
+static FILE* g_rwatch_f=NULL;
+void g_rwatch_log(uint32 wa,uint32 pc){ if(!g_rwatch_f) { char nm[96]; snprintf(nm,sizeof nm,"/tmp/snestest/rwatch_%d.log",(int)getpid()); g_rwatch_f=fopen(nm,"w"); } fprintf(g_rwatch_f,"%05X %06X\n",wa,pc); }
+extern "C" RETRO_API void dbg_set_rwatch(unsigned lo,unsigned hi){ g_rwatch_lo=lo; g_rwatch_hi=hi; if(g_rwatch_f) fflush(g_rwatch_f); }
+extern "C" RETRO_API void dbg_rflush(void){ if(g_rwatch_f) fflush(g_rwatch_f); }
+extern "C" RETRO_API unsigned dbg_pc(void){ return Registers.PBPC; }
+extern "C" RETRO_API unsigned dbg_reg(int i){ switch(i){case 0:return Registers.A.W;case 1:return Registers.X.W;case 2:return Registers.Y.W;case 3:return Registers.S.W;case 4:return Registers.P.W;case 5:return Registers.DB;case 6:return Registers.D.W;} return 0; }
+
+uint32 g_trace_on = 0, g_trace_pos = 0, g_trace_buf[0x10000];
+uint8 g_trace_valid[256] = {1};
+extern "C" RETRO_API void dbg_trace_valid_banks(const unsigned char *m){ memcpy(g_trace_valid, m, 256); }
+extern "C" RETRO_API unsigned dbg_trace_state(void){ return g_trace_on; }
+extern "C" RETRO_API void dbg_trace_enable(unsigned on){ g_trace_on = on; if (on) g_trace_pos = 0; }
+extern "C" RETRO_API unsigned dbg_trace_read(unsigned *out, unsigned n){
+    unsigned have = g_trace_pos < 0x10000 ? g_trace_pos : 0x10000; if (n > have) n = have;
+    for (unsigned i = 0; i < n; i++) out[i] = g_trace_buf[(g_trace_pos - n + i) & 0xFFFF];
+    return n; }
